# -----------------------------------------------------------------------
# Argo Rollouts - Canary Deployment Strategy
# -----------------------------------------------------------------------
#
# Argo Rollouts extends Kubernetes with advanced deployment strategies
# like canary and blue-green. A Rollout resource replaces the standard
# Deployment and gives you fine-grained control over how traffic is
# shifted to a new version.
#
# How canary deployments work with Argo Rollouts:
#
#   1. When a new image is detected, Rollouts creates a "canary" ReplicaSet
#      with the new version alongside the existing "stable" ReplicaSet.
#
#   2. Traffic is gradually shifted to the canary based on the steps you
#      define (e.g., 5% -> 25% -> 100%). Each step can include a pause
#      for manual approval or timed observation.
#
#   3. At each step, an AnalysisTemplate can run automated checks (e.g.,
#      hitting a health endpoint, checking error rates in Prometheus) to
#      decide whether to proceed or abort.
#
#   4. If analysis fails at any step, the rollout automatically aborts
#      and traffic is shifted back to the stable version.
#
#   5. Once all steps complete successfully, the canary becomes the new
#      stable version and the old ReplicaSet is scaled down.
#
# Candidates: complete the TODOs to build a production-ready canary
# deployment. This Rollout replaces the Deployment in k8s/base/.
#
# Docs: https://argoproj.github.io/argo-rollouts/features/canary/
# -----------------------------------------------------------------------

apiVersion: argoproj.io/v1alpha1
kind: Rollout
metadata:
  name: opsboard
  namespace: opsboard
  labels:
    app.kubernetes.io/name: opsboard
spec:
  replicas: 3
  revisionHistoryLimit: 3
  selector:
    matchLabels:
      app.kubernetes.io/name: opsboard
  template:
    metadata:
      labels:
        app.kubernetes.io/name: opsboard
    spec:
      containers:
        - name: opsboard
          image: opsboard:latest
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3000
              protocol: TCP
          envFrom:
            - configMapRef:
                name: opsboard-config
          # NOTE: You should add probes, resources, and securityContext
          # here just as you would for the base Deployment.

  strategy:
    canary:
      # ---- Canary Service References ----
      # The stable and canary services are used for traffic splitting.
      # You need two Service objects: one for stable traffic and one
      # for canary traffic. The Rollouts controller updates their
      # selectors automatically.
      #
      # canaryService: opsboard-canary
      # stableService: opsboard

      # ---- Traffic Routing (optional) ----
      # If using a service mesh or ingress controller for traffic
      # splitting, configure it here. Without this, Rollouts uses
      # replica-ratio-based traffic splitting.
      #
      # trafficRouting:
      #   nginx:
      #     stableIngress: opsboard-ingress

      # ---- Canary Steps ----
      # TODO: Define the canary progression steps.
      # Each step shifts a percentage of traffic to the canary version.
      # Use "pause" steps to observe the canary before proceeding.
      #
      # Recommended progression: 5% -> pause -> 25% -> pause -> 100%
      #
      # Steps reference:
      #   - setWeight: <percentage>    # shift this % of traffic to canary
      #   - pause: {duration: 60s}     # wait before next step (omit duration for manual approval)
      #   - analysis: ...              # run an AnalysisTemplate at this step
      #
      # steps:
      #   - setWeight: ???
      #   - pause:
      #       duration: ???
      #   - setWeight: ???
      #   - pause:
      #       duration: ???
      #   - setWeight: ???

      # ---- Analysis ----
      # TODO: Reference the AnalysisTemplate below to run automated
      # checks during the canary progression. Analysis runs in the
      # background and aborts the rollout if it fails.
      #
      # analysis:
      #   templates:
      #     - templateName: opsboard-health-check
      #   startingStep: 1          # begin analysis after the first setWeight
      #   args:
      #     - name: service-name
      #       value: opsboard-canary

      # TODO: Configure anti-affinity rules to prevent canary and stable
      # pods from landing on the same node, improving blast radius isolation.
      #
      # antiAffinity:
      #   preferredDuringSchedulingIgnoredDuringExecution:
      #     weight: 100

      # TODO: Set a scaleDownDelay to keep old ReplicaSet pods running
      # briefly after traffic is shifted away, allowing in-flight
      # requests to complete gracefully.
      #
      # scaleDownDelaySeconds: 30

---
# -----------------------------------------------------------------------
# AnalysisTemplate - Health Check
# -----------------------------------------------------------------------
# This template defines an automated check that Argo Rollouts runs
# during the canary progression. If the check fails, the rollout
# is automatically aborted and traffic is shifted back to stable.
#
# Candidates: complete this template so it periodically hits the
# /api/health endpoint on the canary service and verifies a 200
# response. Consider what interval, count, and failure thresholds
# are appropriate for your use case.
# -----------------------------------------------------------------------

apiVersion: argoproj.io/v1alpha1
kind: AnalysisTemplate
metadata:
  name: opsboard-health-check
  namespace: opsboard
spec:
  # Args allow the template to be reused with different services.
  args:
    - name: service-name

  metrics:
    - name: health-check
      # TODO: Configure the measurement schedule.
      # interval: how often to run the check (e.g., 30s)
      # count: total number of measurements before concluding (e.g., 5)
      # successCondition: what constitutes a passing check
      # failureLimit: how many failures to tolerate before aborting
      #
      # interval: ???
      # count: ???
      # failureLimit: ???
      # successCondition: "result == 200"

      provider:
        # The "web" provider makes HTTP requests and returns the status code.
        # TODO: Configure the provider to check the canary health endpoint.
        #
        # web:
        #   url: "http://{{args.service-name}}.opsboard.svc.cluster.local/api/health"
        #   method: GET
        #   timeoutSeconds: 5
        #   # jsonPath: "{$.status}"   # optional: extract a field from JSON response
        #   # insecure: true           # skip TLS verification if needed
        {}

    # TODO: (Optional) Add a second metric that queries Prometheus for
    # error rate or latency data. This provides a more comprehensive
    # canary analysis beyond simple health checks.
    #
    # - name: error-rate
    #   interval: 60s
    #   successCondition: "result[0] < 0.05"   # less than 5% error rate
    #   failureLimit: 2
    #   provider:
    #     prometheus:
    #       address: http://prometheus.monitoring.svc.cluster.local:9090
    #       query: |
    #         sum(rate(http_requests_total{service="{{args.service-name}}",status=~"5.."}[5m]))
    #         /
    #         sum(rate(http_requests_total{service="{{args.service-name}}"}[5m]))
